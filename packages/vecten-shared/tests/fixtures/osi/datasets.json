{
  "version": "0.1.1",
  "semantic_model": [
    {
      "name": "acme",
      "datasets": [
        {
          "name": "company_overview",
          "source": "warehouse.marts.company_overview",
          "primary_key": [
            "company_id"
          ],
          "description": "One row per company with its deal totals.",
          "fields": [
            {
              "name": "company_id",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "company_id"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "Company identifier in the demo source."
            },
            {
              "name": "name",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "name"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "Registered company name."
            },
            {
              "name": "domain",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "domain"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "Apex web domain, lower-cased, without protocol, www or path."
            },
            {
              "name": "email",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "email"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "Contact email, lower-cased and trimmed; null when the source held none."
            },
            {
              "name": "country",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "country"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "ISO 3166-1 alpha-2 country code."
            },
            {
              "name": "deal_count",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "deal_count"
                  }
                ]
              },
              "description": "Number of deals with the company."
            },
            {
              "name": "total_amount",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "total_amount"
                  }
                ]
              },
              "description": "Sum of the company's deal values in the source currency."
            },
            {
              "name": "first_deal_date",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "first_deal_date"
                  }
                ]
              },
              "dimension": {
                "is_time": true
              },
              "description": "Day the company's first deal was created."
            }
          ],
          "custom_extensions": [
            {
              "vendor_name": "COMMON",
              "data": "{\"vecten\": {\"snapshot_derived\": true}}"
            }
          ]
        },
        {
          "name": "sales_pipeline",
          "source": "warehouse.marts.sales_pipeline",
          "primary_key": [
            "deal_id"
          ],
          "description": "Every deal with the company it is with, for pipeline reporting.",
          "fields": [
            {
              "name": "deal_id",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "deal_id"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "Deal identifier in the demo source."
            },
            {
              "name": "company_name",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "company_name"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "Registered name of the company the deal is with."
            },
            {
              "name": "country",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "country"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "ISO 3166-1 alpha-2 country code of the company.",
              "ai_context": {
                "synonyms": [
                  "market"
                ]
              }
            },
            {
              "name": "stage",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "stage"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "Pipeline stage, one of open, won or lost."
            },
            {
              "name": "amount",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "amount"
                  }
                ]
              },
              "description": "Deal value in the source currency.",
              "ai_context": {
                "synonyms": [
                  "value",
                  "deal size"
                ]
              }
            },
            {
              "name": "created_at",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "created_at"
                  }
                ]
              },
              "dimension": {
                "is_time": true
              },
              "description": "When the deal was created in the source, UTC."
            },
            {
              "name": "close_date",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "close_date"
                  }
                ]
              },
              "dimension": {
                "is_time": true
              },
              "description": "Day the deal closed; null while it is open."
            },
            {
              "name": "is_won",
              "expression": {
                "dialects": [
                  {
                    "dialect": "ANSI_SQL",
                    "expression": "is_won"
                  }
                ]
              },
              "dimension": {
                "is_time": false
              },
              "description": "True when the deal closed as won."
            }
          ],
          "custom_extensions": [
            {
              "vendor_name": "COMMON",
              "data": "{\"vecten\": {\"snapshot_derived\": true}}"
            }
          ]
        }
      ]
    }
  ]
}
