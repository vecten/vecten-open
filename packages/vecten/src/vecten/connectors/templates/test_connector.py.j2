"""Replay recorded fixtures for {{ name }} offline.

`vecten connector run {{ name }} --record` saves output rows for a local load.
For a source with an injectable reader, add `--record-inputs` to test connector.py
against saved upstream JSON. Run `vecten connector run {{ name }} --json` for a live sync.
"""

from pathlib import Path

from vecten_platform.sync.testing import replay_connector_test


def test_{{ name }}_replays_recorded_fixtures(tmp_path, monkeypatch):
    replay_connector_test(Path(__file__).parent, "{{ name }}", tmp_path, monkeypatch)
