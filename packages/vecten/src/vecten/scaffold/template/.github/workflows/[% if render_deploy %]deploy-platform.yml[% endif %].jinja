name: deploy-platform
on:
  workflow_call:
    inputs:
      environment:
        type: string
        required: true
    secrets:
[%- if cloud != 'aws' %]
      # Required, so a caller that does not pass the deploy key fails instead of shipping
      # with an empty one.
      VECTEN_SCW_ACCESS_KEY:
        required: true
      VECTEN_SCW_SECRET_KEY:
        required: true
[%- endif %]
      # Optional: only a project with extensions from a private git repository needs one.
      VECTEN_GIT_CREDENTIALS:
        required: false
      VECTEN_GIT_APP_PRIVATE_KEY:
        required: false
  workflow_dispatch:
    inputs:
      environment:
        description: Environment to ship to
        required: true
        default: prod
permissions:
  contents: read
jobs:
  ship:
    runs-on: [[ github_runner ]]
[%- if cloud == 'aws' %]
    # The deploy role trusts only jobs that declare the environment it was bootstrapped for.
    environment: ${{ inputs.environment }}
[%- else %]
    # The deploy key is an environment secret, which GitHub hands only to jobs that declare
    # the environment, and in a called workflow only when the caller passes it by name.
    environment: ${{ inputs.environment }}
[%- endif %]
    permissions:
[%- if cloud == 'aws' %]
      id-token: write
[%- endif %]
      contents: read
      pull-requests: read
    # The apply workflow holds the same group, so a ship never runs beside an apply. Callers
    # hold no group, or this job would wait on its own caller.
    concurrency:
      group: deploy-${{ inputs.environment }}
      cancel-in-progress: false
    # A step's condition cannot read a secret, so the job says only whether the App's key is set.
    env:
      VECTEN_GIT_APP_KEY_SET: ${{ secrets.VECTEN_GIT_APP_PRIVATE_KEY != '' }}
    steps:
      - uses: [[ action_checkout ]]
        with:
          fetch-depth: 0
      - uses: [[ action_setup_uv ]]
      - run: uv tool install "vecten==[[ vecten_version ]]"
      # A token for the extensions' git repositories, minted for this job only when the
      # GitHub App, its owner and the repositories it may read are all configured, so it never
      # reaches every repository the App is installed on; only the vecten step reads it.
      - id: git-app-token
        if: vars.VECTEN_GIT_APP_ID != '' && vars.VECTEN_GIT_APP_OWNER != '' && vars.VECTEN_GIT_APP_REPOSITORIES != '' && env.VECTEN_GIT_APP_KEY_SET == 'true'
        uses: [[ action_create_github_app_token ]]
        with:
          client-id: ${{ vars.VECTEN_GIT_APP_ID }}
          private-key: ${{ secrets.VECTEN_GIT_APP_PRIVATE_KEY }}
          owner: ${{ vars.VECTEN_GIT_APP_OWNER }}
          repositories: ${{ vars.VECTEN_GIT_APP_REPOSITORIES }}
          permission-contents: read
[%- if cloud == 'aws' %]
      # The session keeps IAM's default hour, the longest the deploy role allows.
      - uses: [[ action_configure_aws_credentials ]]
        with:
          role-to-assume: ${{ vars.VECTEN_AWS_ROLE_ARN }}
          aws-region: [[ region | tojson ]]
[%- endif %]
      - run: vecten ship --env ${{ inputs.environment }} --json
        env:
          GH_TOKEN: ${{ github.token }}
          # The minted token and the secret's entries together, so an App on GitHub and a
          # token for another host can serve one project.
          GIT_CREDENTIALS: ${{ format('{0} {1}', steps.git-app-token.outputs.token && format('https://x-access-token:{0}@github.com', steps.git-app-token.outputs.token) || '', secrets.VECTEN_GIT_CREDENTIALS) }}
[%- if cloud != 'aws' %]
          SCW_ACCESS_KEY: ${{ secrets.VECTEN_SCW_ACCESS_KEY }}
          SCW_SECRET_KEY: ${{ secrets.VECTEN_SCW_SECRET_KEY }}
[%- endif %]
