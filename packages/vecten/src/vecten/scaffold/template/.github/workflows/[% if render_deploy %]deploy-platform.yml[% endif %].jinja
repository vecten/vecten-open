name: deploy-platform
on:
  workflow_call:
    inputs:
      environment:
        type: string
        required: true
      # A commit of the default branch to ship instead of the run's own.
      commit:
        type: string
        required: false
        default: ""
[%- if cloud != 'aws' %]
    # Required, so a caller that does not pass the deploy key fails instead of shipping
    # with an empty one.
    secrets:
      VECTEN_SCW_ACCESS_KEY:
        required: true
      VECTEN_SCW_SECRET_KEY:
        required: true
[%- endif %]
  workflow_dispatch:
    inputs:
      environment:
        description: Environment to ship to
        required: true
        default: prod
      commit:
        description: Commit of the default branch to ship; empty ships the branch's head
        required: false
        default: ""
permissions:
  contents: read
jobs:
  ship:
    runs-on: [[ github_runner ]]
[%- if cloud == 'aws' %]
    # The deploy role trusts only jobs that declare the environment it was bootstrapped for.
    environment: ${{ inputs.environment }}
[%- else %]
    # The deploy key is an environment secret, which GitHub hands only to jobs that declare
    # the environment, and in a called workflow only when the caller passes it by name.
    environment: ${{ inputs.environment }}
[%- endif %]
    permissions:
[%- if cloud == 'aws' %]
      id-token: write
[%- endif %]
      contents: read
      pull-requests: read
      # Every ship records its outcome on the commit as `vecten/ship/<env>`.
      statuses: write
    # The apply workflow holds the same group, so a ship never runs beside an apply. Callers
    # hold no group, or this job would wait on its own caller.
    concurrency:
      group: deploy-${{ inputs.environment }}
      cancel-in-progress: false
    steps:
      - uses: [[ action_checkout ]]
        with:
          fetch-depth: 0
      - uses: [[ action_setup_uv ]]
      # The CLI that built the commit for the environment before this one builds it here:
      # the version its vecten.toml names, not the one this workflow was rendered with.
      - id: version
        run: |
          python3 - >> "$GITHUB_OUTPUT" <<'EOF'
          import os, re, subprocess, sys, tomllib
          commit = os.environ["COMMIT"] or os.environ["GITHUB_SHA"]
          if not re.fullmatch(r"[0-9a-f]{7,40}", commit):
              sys.exit(f"commit must be a commit id of 7 to 40 hex digits; got {commit!r}")
          shown = subprocess.run(
              ["git", "show", f"{commit}:vecten.toml"], capture_output=True, text=True
          )
          if shown.returncode != 0:
              sys.exit(f"git show {commit}:vecten.toml failed: {shown.stderr.strip()}")
          version = tomllib.loads(shown.stdout)["project"]["scaffold_version"]
          if not re.fullmatch(r"[0-9]+(\.[0-9]+)*((a|b|rc)[0-9]+)?", version):
              sys.exit(f"scaffold_version at {commit} is no vecten release; got {version!r}")
          print(f"vecten={version}")
          EOF
        env:
          COMMIT: ${{ inputs.commit }}
      - run: uv tool install "vecten==$VECTEN_VERSION"
        env:
          VECTEN_VERSION: ${{ steps.version.outputs.vecten }}
[%- if cloud == 'aws' %]
      # The session keeps IAM's default hour, the longest the deploy role allows.
      - uses: [[ action_configure_aws_credentials ]]
        with:
          role-to-assume: ${{ vars.VECTEN_AWS_ROLE_ARN }}
          aws-region: [[ region | tojson ]]
[%- endif %]
      - run: vecten ship --env ${{ inputs.environment }} ${COMMIT:+--commit "$COMMIT"} --json
        env:
          GH_TOKEN: ${{ github.token }}
          COMMIT: ${{ inputs.commit }}
[%- if cloud != 'aws' %]
          SCW_ACCESS_KEY: ${{ secrets.VECTEN_SCW_ACCESS_KEY }}
          SCW_SECRET_KEY: ${{ secrets.VECTEN_SCW_SECRET_KEY }}
[%- endif %]
