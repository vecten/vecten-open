name: ci
on:
  pull_request:
  push:
    branches: [main]
jobs:
  check:
    runs-on: [[ github_runner ]]
    steps:
      - uses: [[ action_checkout ]]
      - uses: [[ action_setup_uv ]]
      - run: uv tool install "vecten==[[ vecten_version ]]"
      - run: python -c "import tomllib; tomllib.load(open('vecten.toml','rb'))"
      - run: uvx ruff@[[ ruff_version ]] check .
[% if 'platform' in components %]      # pytest exits 5 when it collects no test, which is every project before its first connector.
      - run: uvx --with "vecten==[[ vecten_version ]]" pytest connectors -q -p no:cacheprovider || test $? -eq 5
[% endif %]      - run: uvx --with "vecten==[[ vecten_version ]]" vecten mcp validate
[% if 'platform' in components %]      - run: docker info
      - run: uvx --with "vecten==[[ vecten_version ]]" vecten dbt-build-local --check
[% endif %]