name: ci
on:
  pull_request:
  push:
    branches: [main]
jobs:
  check:
    runs-on: [[ github_runner ]]
    steps:
      - uses: [[ action_checkout ]]
        with:
          persist-credentials: false
      - uses: [[ action_setup_uv ]]
      - run: uv tool install "vecten==[[ vecten_version ]]"
      - name: Check in-repo extension declarations
        if: hashFiles('extensions/*/pyproject.toml', 'extensions.lock.json') != ''
        shell: bash
        run: |
          python="$(uv tool dir)/vecten/bin/python"
          if test -f requirements.txt && grep -q '^\./extensions/' requirements.txt; then
            # The CLI lock also records Git URLs. Only index pins and editable local packages
            # are needed to read this checkout's declarations.
            awk '!/ @ /' requirements.lock > "$RUNNER_TEMP/vecten-index.lock"
            uv pip install --python "$python" --no-deps -r "$RUNNER_TEMP/vecten-index.lock"
            while IFS= read -r path; do
              uv pip install --python "$python" --no-deps -e "$path"
            done < <(grep '^\./extensions/' requirements.txt)
          fi
          vecten lock --check
      - run: python -c "import tomllib; tomllib.load(open('vecten.toml','rb'))"
      - run: uvx ruff@[[ ruff_version ]] check .
[% if 'platform' in components %]      # pytest exits 5 when it collects no test, which is every project before its first connector.
      - run: uvx --with "vecten==[[ vecten_version ]]" pytest connectors -q -p no:cacheprovider || test $? -eq 5
[% endif %]      - run: uvx --with "vecten==[[ vecten_version ]]" vecten mcp validate
[% if 'platform' in components %]      - run: docker info
      - run: uvx --with "vecten==[[ vecten_version ]]" vecten dbt-build-local --check
[% endif %]