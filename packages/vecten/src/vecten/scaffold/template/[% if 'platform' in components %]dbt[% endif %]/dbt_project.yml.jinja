name: "[[ project_name | replace('-', '_') ]]"
version: "1.0.0"
config-version: 2
profile: "vecten"
require-dbt-version: [">=1.12.0", "<1.13.0"]
model-paths: ["models"]
snapshot-paths: ["snapshots"]
macro-paths: ["macros"]
test-paths: ["tests"]
# vecten points VECTEN_OSI_PATH at an empty directory while it builds, because the build
# writes osi/datasets.json; every other dbt command reads ../osi.
osi-paths: ["{{ env_var('VECTEN_OSI_PATH', '../osi') }}"]
target-path: "target"
packages-install-path: "{{ env_var('DBT_PACKAGES_INSTALL_PATH', 'dbt_packages') }}"
clean-targets: ["target", "dbt_packages"]
models:
[% if warehouse == 'snowflake' %]  # A rebuilt relation keeps the grants of the one it replaces, in the same statement.
  +copy_grants: true
[% endif %]  "[[ project_name | replace('-', '_') ]]":
    staging:
      +schema: staging
      +materialized: view
    core:
      +schema: core
      +materialized: table
    marts:
      +schema: marts
      +materialized: table
snapshots:
  "[[ project_name | replace('-', '_') ]]":
    +schema: snapshots
