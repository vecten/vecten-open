# Editable project configuration. The CLI reads changes on the next invocation.
users = [[ users ]]
size = [[ size | tojson ]]
components = [[ components | tojson ]]
profile = [[ profile | tojson ]]
wanted = [[ sources | tojson ]]
extensions = []
connectors = []

[project]
name = [[ project_name | tojson ]]
scaffold_version = [[ vecten_version | tojson ]]
convention_version = [[ convention_version ]]

[warehouse]
kind = [[ warehouse | tojson ]]
existing = [[ has_warehouse | tojson ]]
[% if has_warehouse -%]
[% if warehouse_host %]host = [[ warehouse_host | tojson ]]
[% endif -%]
[% if warehouse_port %]port = [[ warehouse_port ]]
[% endif -%]
[% if warehouse_database %]database = [[ warehouse_database | tojson ]]
[% endif -%]
[% if warehouse_account %]account = [[ warehouse_account | tojson ]]
[% endif -%]
[% if warehouse_admin_user %]admin_user = [[ warehouse_admin_user | tojson ]]
[% endif -%]
[% elif warehouse_account -%]
account = [[ warehouse_account | tojson ]]
[% endif -%]
[% if render_deploy %]

[deploy]
cloud = [[ cloud | tojson ]]
region = [[ region | tojson ]]
domain = [[ domain | tojson ]]
dns_zone = [[ dns_zone | tojson ]]
github_repository = [[ github_repository | tojson ]]
[% endif %]

[mcp]
admins = []
