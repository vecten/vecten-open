#!/bin/bash
# cloud-init runs this once, at first boot; every step leaves the same state when rerun by hand.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

retry() {
  local attempt=1
  until "$@"; do
    if [ "$attempt" -ge 10 ]; then
      echo "vecten user data: gave up after $attempt attempts: $*" >&2
      return 1
    fi
    attempt=$((attempt + 1))
    sleep 15
  done
}

# Unattended upgrades hold the dpkg lock for minutes after first boot.
retry apt-get -o DPkg::Lock::Timeout=300 update
retry apt-get -o DPkg::Lock::Timeout=300 install -y --no-install-recommends docker.io python3 ca-certificates curl

# Docker, the units and the timers come before the plugin downloads, so a download that gives
# up still leaves a host that restarts its stack after a reboot and picks up the next ship;
# the agent installs a missing plugin when it ships.
systemctl enable --now docker

install -d -m 0755 /opt/vecten/releases /opt/vecten/agent /var/www/certbot /etc/letsencrypt

# The watcher runs this copy of the agent, so it pulls the first bundle before any release
# exists on the host.
base64 -d <<'AGENT' | gunzip -c > /opt/vecten/agent/apply.py.new
${agent_gzip_base64}
AGENT
chmod 0755 /opt/vecten/agent/apply.py.new
mv /opt/vecten/agent/apply.py.new /opt/vecten/agent/apply.py

# Before the first release the watcher knows its host, bucket and project only from here.
install -d -m 0755 /etc/vecten
cat > /etc/vecten/watch.json <<'WATCH'
${watch_config}
WATCH

# The metadata server serves the VM key to any root process, and Docker grants containers the
# low source port it requires; container traffic to it is dropped. A reboot clears the rules,
# so the unit re-adds them whenever Docker starts.
cat > /etc/systemd/system/vecten-metadata-guard.service <<'UNIT'
[Unit]
Description=Vecten: keep containers off the instance metadata server
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -d 169.254.42.42 -j DROP 2>/dev/null || iptables -I DOCKER-USER -d 169.254.42.42 -j DROP'
ExecStart=-/bin/sh -c 'ip6tables -C DOCKER-USER -d fd00:42::42 -j DROP 2>/dev/null || ip6tables -I DOCKER-USER -d fd00:42::42 -j DROP'

[Install]
WantedBy=docker.service
UNIT

# /run/vecten is tmpfs and empty after a reboot; the agent rebuilds it before Compose starts.
cat > /etc/systemd/system/vecten-boot.service <<'UNIT'
[Unit]
Description=Vecten: rebuild run files and start the current release
Requires=docker.service
After=docker.service network-online.target vecten-metadata-guard.service
Wants=network-online.target
ConditionPathExists=/opt/vecten/releases/current

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/vecten/releases/current/.vecten/ship/apply.py boot

[Install]
WantedBy=multi-user.target
UNIT

# A ship runs inside one watch run, so the start timeout bounds a ship rather than a poll; the
# timer never starts a second run while one is still active.
cat > /etc/systemd/system/vecten-watch.service <<'UNIT'
[Unit]
Description=Vecten: ship the commit this host's release pointer names
Requires=docker.service
After=docker.service network-online.target vecten-metadata-guard.service vecten-boot.service
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=30min
ExecStart=/usr/bin/python3 /opt/vecten/agent/apply.py watch
UNIT

cat > /etc/systemd/system/vecten-watch.timer <<'UNIT'
[Unit]
Description=Vecten: check the release pointer every 15 seconds

[Timer]
OnBootSec=15s
OnUnitActiveSec=15s
AccuracySec=1s

[Install]
WantedBy=timers.target
UNIT

# systemd expands $ in ExecStart lines, so the shell's command substitution is written $$( ).
cat > /etc/systemd/system/vecten-certbot-renew.service <<'UNIT'
[Unit]
Description=Vecten: renew Let's Encrypt certificates and reload NGINX
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker run --rm -v /etc/letsencrypt:/etc/letsencrypt -v /var/www/certbot:/var/www/certbot ${certbot_image} renew --non-interactive --webroot -w /var/www/certbot
ExecStartPost=-/bin/sh -c 'docker exec $$(docker ps -q --filter label=com.docker.compose.service=nginx) nginx -s reload'
UNIT

cat > /etc/systemd/system/vecten-certbot-renew.timer <<'UNIT'
[Unit]
Description=Vecten: daily Let's Encrypt renewal

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now vecten-metadata-guard.service
systemctl enable vecten-boot.service
systemctl enable --now vecten-certbot-renew.timer
systemctl enable --now vecten-watch.timer

compose_url="https://github.com/docker/compose/releases/download/v${compose_plugin_version}/docker-compose-linux-x86_64"
workdir="$(mktemp -d)"
retry curl -fsSL -o "$workdir/docker-compose-linux-x86_64" "$compose_url"
retry curl -fsSL -o "$workdir/docker-compose-linux-x86_64.sha256" "$compose_url.sha256"
(cd "$workdir" && sha256sum -c docker-compose-linux-x86_64.sha256)
install -D -m 0755 "$workdir/docker-compose-linux-x86_64" /usr/local/lib/docker/cli-plugins/docker-compose
rm -rf "$workdir"

buildx_asset="buildx-v${buildx_plugin_version}.linux-amd64"
workdir="$(mktemp -d)"
retry curl -fsSL -o "$workdir/$buildx_asset" "https://github.com/docker/buildx/releases/download/v${buildx_plugin_version}/buildx-v${buildx_plugin_version}.linux-amd64"
retry curl -fsSL -o "$workdir/checksums.txt" "https://github.com/docker/buildx/releases/download/v${buildx_plugin_version}/checksums.txt"
# checksums.txt lists every platform, its names with or without sha256sum's binary marker `*`;
# only this asset's line is checked.
(cd "$workdir" && grep -E "^[0-9a-f]{64} [ *]$buildx_asset\$" checksums.txt | sha256sum -c -)
install -D -m 0755 "$workdir/$buildx_asset" /usr/local/lib/docker/cli-plugins/docker-buildx
rm -rf "$workdir"
